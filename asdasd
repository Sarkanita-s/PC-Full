<main>
    <!-- HERO SECTION -->
    <section id="inicio" class="hero-section">
        <div class="hero-content">
            <h2>Servicio Técnico Profesional de Computadoras</h2>
            <p>Reparación, mantenimiento y optimización de equipos con garantía y calidad</p>
            <div class="hero-buttons">
                <a href="#solicitar" class="btn btn-primary">Solicitar Servicio</a>
                <a href="#servicios" class="btn btn-outline" style="color: var(--primary-color); border-color: var(--primary-color);">Ver Servicios</a>
            </div>
        </div>
        <div class="hero-image">
            <span style="font-size: 8rem;">🔧💻</span>
        </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" class="services-section">
        <h2>Nuestros Servicios</h2>
        <div class="services-grid">
            <div class="service-card">
                <span class="service-icon">🖥️</span>
                <h3>Reparación de Hardware</h3>
                <p>Cambio de componentes, fuentes, pantallas, teclados y más</p>
            </div>
            
            <div class="service-card">
                <span class="service-icon">⚙️</span>
                <h3>Mantenimiento Software</h3>
                <p>Limpieza de virus, instalación de sistemas operativos, optimización</p>
            </div>
            
            <div class="service-card">
                <span class="service-icon">🚀</span>
                <h3>Actualizaciones</h3>
                <p>Mejora el rendimiento de tu equipo con componentes modernos</p>
            </div>
            
            <div class="service-card">
                <span class="service-icon">📡</span>
                <h3>Redes e Internet</h3>
                <p>Configuración de redes, WiFi, y solución de problemas de conexión</p>
            </div>
        </div>
    </section>

    <!-- FORMULARIO DE SOLICITUD -->
    <section id="solicitar" class="request-section">
        <h2>Solicita tu Servicio</h2>
        <div class="request-form">
            <form id="serviceRequestForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Nombre completo *</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="phone">Teléfono *</label>
                        <input type="tel" id="phone" name="phone" required>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email">
                </div>
                
                <div class="form-group">
                    <label for="equipment">Tipo de equipo *</label>
                    <select id="equipment" name="equipment" required>
                        <option value="">Seleccionar...</option>
                        <option value="laptop">Laptop</option>
                        <option value="desktop">Computadora de Escritorio</option>
                        <option value="monitor">Monitor</option>
                        <option value="printer">Impresora</option>
                        <option value="other">Otro</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="brand">Marca y Modelo</label>
                    <input type="text" id="brand" name="brand" placeholder="Ej: HP Pavilion, Dell Inspiron...">
                </div>
                
                <div class="form-group">
                    <label for="problem">Describe el problema *</label>
                    <textarea id="problem" name="problem" rows="4" required placeholder="¿Qué está fallando en tu equipo?"></textarea>
                </div>
                
                <button type="submit" class="btn btn-primary">Enviar Solicitud</button>
            </form>
        </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="contact-section">
        <h2>Contacto</h2>
        <div class="contact-info">
            <div class="contact-item">
                <span class="contact-icon">📞</span>
                <h3>Teléfono</h3>
                <p>(123) 456-7890</p>
            </div>
            
            <div class="contact-item">
                <span class="contact-icon">✉️</span>
                <h3>Email</h3>
                <p>servicio@pcfull.com</p>
            </div>
            
            <div class="contact-item">
                <span class="contact-icon">🏢</span>
                <h3>Dirección</h3>
                <p>Av. Principal #123, Ciudad</p>
            </div>
            
            <div class="contact-item">
                <span class="contact-icon">🕒</span>
                <h3>Horario</h3>
                <p>Lun-Vie: 9:00 - 18:00<br>Sáb: 9:00 - 14:00</p>
            </div>
        </div>
    </section>
</main>

